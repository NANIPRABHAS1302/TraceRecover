# ==============================================================================
# TraceRecover Environment Configuration (Template - NEVER commit real secrets)
# Copy this file to `.env` for local development or inject via platform secret
# manager (Render / Fly.io / Railway / Docker) in production.
# ==============================================================================

# Provider Selection: local | gemini | openai | anthropic
LLM_PROVIDER=local
LLM_REQUEST_TIMEOUT=30

# Optional Remote LLM Provider API Keys (kept strictly server-side; never commit real keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Local Model Server Endpoints (Ollama / LM Studio / vLLM)
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.1
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-model

# Optional Model Overrides
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Admin token required for POST /api/experiments/run, /api/datasets/import, /api/unseen/run, and connector mutations.
# Strongly recommended before exposing the service publicly.
TRACERECOVER_ADMIN_TOKEN=

# Comma-separated allowed CORS origins (never use * in production)
TRACERECOVER_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
TRACERECOVER_TRUST_PROXY=false

# Session & Conversation Retention Limits
TRACERECOVER_MAX_CONVERSATIONS_PER_SESSION=50

# Persistent Storage Directories (mount a persistent disk here in production)
# TRACERECOVER_RESULTS_DIR=/var/data/results
# TRACERECOVER_LOGS_DIR=/var/data/logs
# TRACERECOVER_DATASET_VERSIONS_DIR=/var/data/versions
# TRACERECOVER_CONVERSATIONS_DIR=/var/data/conversations
# TRACERECOVER_UNSEEN_DATASETS_DIR=/var/data/unseen_benchmarks
# TRACERECOVER_CONNECTORS_DIR=/var/data/connectors

# Connector Vault Encryption & Optional External Search/Integration Tokens
# TRACERECOVER_VAULT_KEY=
TRACERECOVER_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SERPAPI_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

# API Protection Limits
TRACERECOVER_RATE_LIMIT_RUN=60
TRACERECOVER_RATE_LIMIT_EXPERIMENTS=10
TRACERECOVER_MAX_REQUEST_BYTES=65536
TRACERECOVER_ENABLE_DOCS=false

# Server Binding
HOST=0.0.0.0
PORT=8000